# ============================================================
#  「随机模仿者」Mod —— Git 忽略规则
#
#  原则：只提交「人写的」和「要发布的」。
#        不提交编译缓存、中间产物，以及含本机绝对路径的日志。
# ============================================================

# ---- 编译缓存 ----
# .cache/ 里是 dotnet_home 与 nuget 缓存（约 117 个文件）
.cache/

# ---- C# 编译中间产物 ----
# src/obj/ 是 MSBuild 生成的中间文件，里面写死了本机路径，
# 例如 F:\桌面\随机模仿者Mod\... 和 C:\Users\<你>\AppData\...
src/obj/
src/bin/

# ---- 构建日志 ----
# 同样含本机绝对路径（用户名、目录结构）
_build.log
src/build.log

# ---- 根目录的 .pmod 副本 ----
# 真正的构建产物是 dist/RandomImitater.pmod —— 那是 build_mod.py 的输出，
# 也是发 Release 时上传的附件。根目录这一份只是手工复制的手发包，
# 容易和 dist/ 不同步（现在两份字节一致，但改完代码重新构建后就不会了），
# 所以不提交，只留 dist/ 那一份作为唯一来源。
/RandomImitater.pmod

# ---- 编辑器 / IDE ----
.vs/
.idea/
.vscode/
*.user
*.suo

# ---- 操作系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时文件与备份 ----
*.tmp
*.bak
*.bak_*
